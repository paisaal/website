-shadow:0 25px 70px rgba(0,0,0,.35);animation:terminal-enter 1s ease backwards .2s;transition:transform .3s ease,border-color .3s ease}.hero-terminal:hover{transform:translateY(-5px);border-color:rgba(181,243,107,.5)}.terminal-header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 18px;border-bottom:1px solid #26332b;color:#929e96;font-family:jetbrains mono,monospace;font-size:10px}.terminal-dots{display:flex;gap:6px}.terminal-dots span{width:9px;height:9px;border-radius:50%;background:#64736a}.terminal-dots span:first-child{background:#f07178}.terminal-dots span:nth-child(2){background:#e9c46a}.terminal-dots span:last-child{background:#b5f36b}.terminal-menu{letter-spacing:2px}.terminal-body{padding:24px 22px;font-family:jetbrains mono,monospace;font-size:11px;line-height:1.8}.terminal-line{color:#f1f5f2;margin-bottom:8px;overflow-wrap:anywhere}.terminal-user{color:#b5f36b}.terminal-path{color:#83b6ff}.terminal-command{display:inline-block;white-space:pre}.terminal-output{color:#929e96;padding-left:12px;margin-bottom:22px}.terminal-output p{margin:0;padding:2px 0}.terminal-output p::before{content:"> ";color:#b5f36b}.terminal-cursor{display:inline-block;color:#b5f36b;animation:cursor-blink 1s steps(2,start)infinite}.terminal-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:16px;margin-top:24px;border-top:1px solid #26332b;color:#929e96;font-size:9px;letter-spacing:.5px}.terminal-online{width:7px;height:7px;border-radius:50%;background:#b5f36b;box-shadow:0 0 10px rgba(181,243,107,.6);margin-right:-4px}.terminal-body.is-animating .terminal-hidden{visibility:hidden;opacity:0}.terminal-output,.terminal-output p,.terminal-result,.terminal-skills p,.terminal-final{transition:opacity .3s ease}.terminal-animating .terminal-result,.terminal-animating .terminal-skills p,.terminal-animating .terminal-final{opacity:0}.tech-section{padding:40px 0;margin-bottom:110px;border-top:1px solid #26332b;border-b