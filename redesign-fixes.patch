diff --git a/layouts/partials/meta/post.html b/layouts/partials/meta/post.html
new file mode 100644
index 0000000..b0ec658
--- /dev/null
+++ b/layouts/partials/meta/post.html
@@ -0,0 +1,58 @@
+{{/*  These meta tags are rendered only in the posts section (i.e. in single/list page)  */}}
+{{ if eq .Section "posts" }}
+    {{ $ISO_date := dateFormat "2006-01-02T15:04:05Z0700" .Date | safeHTML }}
+    <!-- Pagination meta tags for list pages only -->
+    {{ $paginator := .Paginate (where .Pages "Section" "blog") }}
+    {{ if $paginator }}
+    <link rel="first" href="{{ $paginator.First.URL }}" />
+    <link rel="last" href="{{ $paginator.Last.URL }}" />
+    {{ if $paginator.HasPrev }}
+    <link rel="prev" href="{{ $paginator.Prev.URL }}" />
+    {{end }}
+    {{ if $paginator.HasNext }}
+    <link rel="next" href="{{ $paginator.Next.URL }}" />
+    {{end }}
+    {{end }}
+
+    <meta property="og:type" content="article" />
+    <meta property="og:article:published_time" content={{ $ISO_date | safeHTML }} />
+    <meta property="article:published_time" content={{ $ISO_date | safeHTML }} />
+
+    {{ with.Params.author }}
+    <meta property="og:article:author" content="{{humanize . }}" />
+    <meta property="article:author" content="{{humanize . }}" />
+    <meta name="author" content="{{humanize . }}" />
+    {{ end }}
+
+    {{ with.Params.category }}
+    <meta name="news_keywords" content="{{ index . 0 }}" />
+    <meta property="article:section" content="{{ index . 0 }}" />
+    {{ end }}
+
+    {{/*  Data JSON-LD: versi theme mengisi author/description/image dengan nilai kosong  */}}
+    {{- $author := .Params.author | default .Site.Params.author.name -}}
+    {{- $desc := .Params.description | default .Site.Params.description -}}
+    {{- $img := (.Params.image | default .Site.Params.ogimage) | absURL -}}
+    {{- $siteName := .Site.Params.sitename | default .Site.Title -}}
+    <script defer type="application/ld+json">
+    {
+        "@context": "https://schema.org",
+        "@type": "Article",
+        "headline": {{ .Title }},
+        "author": {
+            "@type": "Person",
+            "name": {{ $author }}
+        },
+        "datePublished": "{{ dateFormat "2006-01-02" .Date }}",
+        "description": {{ $desc }},
+        "wordCount": {{ .WordCount }},
+        "mainEntityOfPage": {{ .Permalink }},
+        "dateModified": "{{ dateFormat "2006-01-02" .Lastmod }}",
+        "image": {{ $img }},
+        "publisher": {
+            "@type": "Organization",
+            "name": {{ $siteName }}
+        }
+    }
+    </script>
+{{ end }}
diff --git a/layouts/partials/meta/standard.html b/layouts/partials/meta/standard.html
new file mode 100644
index 0000000..7fbabdd
--- /dev/null
+++ b/layouts/partials/meta/standard.html
@@ -0,0 +1,69 @@
+<meta charset="utf-8">
+<meta http-equiv="content-type" content="text/html">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+
+{{/*
+  Override dari theme hugo-blog-awesome (meta/standard.html).
+  Beda dengan versi theme:
+  - Homepage pakai params.homeTitle (sebelumnya jadi "X | X" karena .Title == .Site.Title)
+  - Halaman lain: "<judul> | <sitename>" (pakai nama singkat, bukan title situs yang panjang)
+  - og:url, og:type (halaman non-posts), twitter:card
+  - og:locale diformat en_US (bukan en-us)
+*/}}
+{{- $siteName := .Site.Params.sitename | default .Site.Title -}}
+{{- $pageTitle := printf "%s | %s" .Title $siteName -}}
+{{- if .IsHome -}}
+  {{- $pageTitle = .Site.Params.homeTitle | default .Site.Title -}}
+{{- end -}}
+
+<title itemprop="name">{{ $pageTitle }}</title>
+<meta property="og:title" content="{{ $pageTitle }}" />
+<meta name="twitter:title" content="{{ $pageTitle }}" />
+<meta itemprop="name" content="{{ $pageTitle }}" />
+<meta name="application-name" content="{{ $pageTitle }}" />
+<meta property="og:site_name" content="{{ $siteName }}" />
+<meta property="og:url" content="{{ .Permalink }}" />
+{{- if ne .Section "posts" }}
+<meta property="og:type" content="website" />
+{{- end }}
+<meta name="twitter:card" content="summary_large_image" />
+
+{{/*  Define empty variable description  */}}
+{{- $description := "" -}}
+
+{{/*  If description is defined in front matter, use it  */}}
+{{- if .Params.description -}}
+  {{- $description = trim .Params.description "\n" -}}
+{{/*  If description is not defined in front matter, use site description  */}}
+{{- else if .Site.Params.description -}}
+  {{- $description = trim .Site.Params.description "\n" -}}
+{{- end -}}
+
+<meta name="description" content="{{ $description }}">
+<meta itemprop="description" content="{{ $description }}" />
+<meta property="og:description" content="{{ $description }}" />
+<meta name="twitter:description" content="{{ $description }}" />
+
+{{/*  en-us -> en_US (format yang dipakai Open Graph)  */}}
+{{- $locale := .Site.LanguageCode -}}
+{{- $parts := split $locale "-" -}}
+{{- if eq (len $parts) 2 -}}
+  {{- $locale = printf "%s_%s" (index $parts 0) (upper (index $parts 1)) -}}
+{{- end -}}
+<meta property="og:locale" content="{{ $locale }}" />
+<meta name="language" content="{{ .Site.LanguageCode }}" />
+{{ range .AllTranslations }}
+  <link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" title="{{ .Language.LanguageName }}" />
+{{ end }}
+
+{{ with .Params.image }}
+  <meta itemprop="image" content="{{ . | absURL }}" />
+  <meta property="og:image" content="{{ . | absURL }}" />
+  <meta name="twitter:image" content="{{ . | absURL }}" />
+  <meta name="twitter:image:src" content="{{ . | absURL }}" />
+{{ else }}
+  <meta itemprop="image" content="{{ .Site.Params.ogimage | absURL }}" />
+  <meta property="og:image" content="{{ .Site.Params.ogimage | absURL }}" />
+  <meta name="twitter:image" content="{{ .Site.Params.ogimage | absURL }}" />
+  <meta name="twitter:image:src" content="{{ .Site.Params.ogimage | absURL }}" />
+{{ end }}
